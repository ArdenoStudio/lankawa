OCTANE_API_BASE=https://octane-api.fly.dev
FLOOD_API_BASE=https://lk-flood-api.vercel.app
PROPERTYLK_API_URL=https://property-price-intelligence-an-ardeno-production.fly.dev
VEHICLE_API_BASE=https://vehicle-platform-backend.fly.dev/api/v1
# FoodLK sister API — often HTTP 500; Lankawa falls through to CBSL price-monitor JSON → WFP → SPAR → Life.
# See docs/FOOD_API_SOURCES.md and docs/EXTERNAL_REPOS_ASSESSMENT.md
FOOD_API_BASE=https://food-platform-backend.fly.dev/api/v1
LIFE_API_BASE=https://life-platform-backend.fly.dev/api/v1
# Optional override for lanka-price-monitor CBSL Daily Price Report JSON
# CBSL_PRICE_MONITOR_JSON_URL=https://raw.githubusercontent.com/wmrkumara/lanka-price-monitor/main/data.json
# Optional override for sri-lanka-macro-publisher CCPI latest JSON
# MACRO_PUBLISHER_CCPI_URL=https://raw.githubusercontent.com/Gajarthan/sri-lanka-macro-publisher/main/data/latest/dcs_ccpi.json

# Optional air quality (OpenAQ v3) — without key, AQI map stays seed/mixed
OPENAQ_API_KEY=

# Optional NASA FIRMS active-fire pins on /disaster (MAP_KEY from FIRMS)
NASA_FIRMS_MAP_KEY=

# Database (optional — app works without these)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cron protection for /api/cron/ingest (recommended in production)
CRON_SECRET=

# Optional LLM civic assistant (strict RAG over Lankawa JSON)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Misc
BOT_CONTACT_URL=https://github.com/ArdenoStudio/lankawa

# Pulse layer (optional — defaults shown)
CSE_LK_API_BASE=https://www.cse.lk/api
NEWS_RSS_FEEDS=
# Opt-in unofficial Helakuru Esana headlines (default off — RSS-first news strategy)
NEWS_ESANA_ENABLED=false
# NEWS_ESANA_API_BASE=https://esana-api.vercel.app

# Optional morning-brief email (requires Supabase brief_subscribers + Resend)
RESEND_API_KEY=
BRIEF_FROM_EMAIL=Lankawa <brief@updates.example.com>
NEXT_PUBLIC_SITE_URL=https://lankawa.vercel.app

# Ops-only Telegram alerts on adapter failure streak (P65 — not consumer UI)
TELEGRAM_OPS_BOT_TOKEN=
TELEGRAM_OPS_CHAT_ID=

# Partner signed change webhooks (P62) — HMAC secret for X-Lankawa-Signature
LANKAWA_WEBHOOK_SECRET=
